{
  "name": "dsh-lion-pet",
  "version": "1.1.1",
  "description": "刑小狮桌宠 —— 把校徽里的刑小狮放进 DeepSeek Harness：待机呼吸、随机散步、点击回应、拖拽甩动、右键菜单、位置记忆，以及桌面悬浮与显示位置切换。",
  "author": "rumpen233",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rumpen233/dsh-lion-pet.git"
  },
  "bugs": {
    "url": "https://github.com/rumpen233/dsh-lion-pet/issues"
  },
  "homepage": "https://github.com/rumpen233/dsh-lion-pet#readme",
  "type": "module",
  "main": "lib/index.js",
  "icon": "assets/icon.png",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "runtime",
    "extension",
    "assets",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "pet",
    "lion",
    "floating-widget"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  }
}
